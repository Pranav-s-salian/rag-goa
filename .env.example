# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
PORT=5000
DEBUG=false

# Sarvam AI API Key (required for STT)
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq API Key (required for LLM generation)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (required for production index bucket access)
HF_TOKEN=your_hf_token_here

# Groq model configuration
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval configuration
STRATEGY_NAME=fixed
TOP_K=10
RERANK_ENABLED=false
GROUNDEDNESS_THRESHOLD=0.3

# Production index settings (HF Bucket)
USE_PRODUCTION_INDEX=true
PRODUCTION_BUCKET=cybercoot/voice-rag-index
INDEX_NPROBE=16

# Generation configuration
MAX_CONTEXT_LENGTH=2048
TEMPERATURE=0.1
MAX_TOKENS=512

# Pipeline configuration
ENABLE_INPUT_FILTER=true
ENABLE_GROUNDEDNESS_CHECK=true
ENABLE_HALLUCINATION_CHECK=true

# Performance tuning
USE_GPU=false
BATCH_SIZE=32
NUM_THREADS=4
